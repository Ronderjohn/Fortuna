SMARTAPI_API_KEY=your_api_key
SMARTAPI_CLIENT_CODE=your_client_id
SMARTAPI_PASSWORD=your_trading_pin
SMARTAPI_TOTP_SECRET=your_totp_secret_base32

# Optional alias for API key:
# ANGEL_API_KEY=same_as_above

# For live WebSocket feed:
SMARTAPI_USE_LIVE_FEED=true

# Set to true only on machines where TLS-intercepting antivirus (Avast/AVG etc.)
# or a corporate proxy replaces server certificates with locally signed ones
# that aren't in Python's certifi bundle. Disables SSL verification process-wide.
FORTUNA_INSECURE_SSL=false

# Agentic advisory layer (advisory-first; optional paper learning).
FORTUNA_AGENTIC_ENABLED=false
FORTUNA_AGENTIC_PAPER_LEARNING_ENABLED=false
FORTUNA_AGENTIC_ML_SCORER_ENABLED=false
FORTUNA_AGENTIC_LOG_DIR=logs/agentic

# Model promotion registry (Phase 5). Off by default — legacy mtime loading preserved.
# When enabled with promotion required, only explicit live pointers are loaded.
FORTUNA_MODEL_REGISTRY_ENABLED=false
FORTUNA_MODEL_PROMOTION_REQUIRED=true
FORTUNA_ML_SCORER_ARTIFACT_DIR=models/ml_signal_scorer/validated
# Dev-only escape hatch for RL; leave false in operator environments.
FORTUNA_RL_ALLOW_GLOBAL_POLICY=false

# Paper/execution stack (agentic paper learning uses paper broker only; never live orders).
FORTUNA_EXECUTION_ENABLED=false
FORTUNA_EXECUTION_ACCOUNT_SYNC=false

# Telegram alerts via bot token + chat id.
FORTUNA_TELEGRAM_ENABLED=false
FORTUNA_TELEGRAM_PROVIDER=telegram
FORTUNA_TELEGRAM_DEDUPE_MEMORY=500
FORTUNA_TELEGRAM_MAX_PER_SYMBOL_PER_SESSION=10
FORTUNA_TELEGRAM_MIN_INTERVAL_SECONDS=300
FORTUNA_TELEGRAM_QUIET_HOURS_ENABLED=true
FORTUNA_TELEGRAM_BOT_TOKEN=
FORTUNA_TELEGRAM_CHAT_ID=
FORTUNA_TELEGRAM_REQUEST_AUDIT_ENABLED=true
# Native conversational layer above typed advisory tools. Keep off by default
# until you explicitly want freer-form Telegram/dashboard prompts.
FORTUNA_CONVERSATIONAL_ADAPTER_ENABLED=false
FORTUNA_CONVERSATIONAL_ADAPTER_MODE=heuristic
FORTUNA_CONVERSATIONAL_MAX_HISTORY=12
# Optional OpenAI planner above typed advisory tools. Keep this off unless
# you explicitly want Responses API tool-calling for freer-form requests.
FORTUNA_OPENAI_API_KEY=
FORTUNA_OPENAI_MODEL=gpt-5.4-mini
FORTUNA_OPENAI_BASE_URL=https://api.openai.com/v1
FORTUNA_OPENAI_TIMEOUT_SECONDS=30
FORTUNA_OPENAI_MAX_OUTPUT_TOKENS=250

# Optional market-universe seed export from Screener. The CLI/tool surface will
# fall back to the instrument registry if this file is absent.
FORTUNA_MARKET_UNIVERSE_SCREENER_CSV=data/universe/screener_export.csv
FORTUNA_MARKET_UNIVERSE_TRADABLE_UNIVERSE_CSV=data/universe/tradable_universe.csv
FORTUNA_MARKET_UNIVERSE_SMARTAPI_SEED_LIMIT=75
FORTUNA_MARKET_UNIVERSE_AUTO_PREFER_SMARTAPI=false
FORTUNA_MARKET_UNIVERSE_DEFAULT_LIMIT=15
FORTUNA_MARKET_UNIVERSE_TURNOVER_WEIGHT=0.46
FORTUNA_MARKET_UNIVERSE_VOLUME_WEIGHT=0.18
FORTUNA_MARKET_UNIVERSE_TREND_WEIGHT=0.08
FORTUNA_MARKET_UNIVERSE_VOLUME_RATIO_WEIGHT=0.10
FORTUNA_MARKET_UNIVERSE_ACTIVITY_WEIGHT=0.18
FORTUNA_MARKET_UNIVERSE_ACTION_BIAS_WEIGHT=0.45
FORTUNA_MARKET_UNIVERSE_REGIME_BIAS_WEIGHT=0.35
FORTUNA_MARKET_UNIVERSE_SIGNAL_BIAS_WEIGHT=0.25
FORTUNA_MARKET_UNIVERSE_GLOBAL_BIAS_WEIGHT=0.20
FORTUNA_MARKET_UNIVERSE_ADAPTIVE_RECENCY_HALFLIFE=18
FORTUNA_MARKET_UNIVERSE_NIGHTLY_FEEDBACK_ENABLED=true
FORTUNA_MARKET_UNIVERSE_NIGHTLY_FEEDBACK_MAX_BOOST=0.10
FORTUNA_MARKET_UNIVERSE_NIGHTLY_FEEDBACK_LOOKBACK_REPORTS=8
FORTUNA_MARKET_UNIVERSE_NIGHTLY_REFRESH_BONUS_WEIGHT=0.65
FORTUNA_MARKET_UNIVERSE_NIGHTLY_REPORT_DIR=reports/nightly
FORTUNA_MARKET_UNIVERSE_FUNDAMENTALS_OVERLAY_ENABLED=false
FORTUNA_MARKET_UNIVERSE_FUNDAMENTALS_OVERLAY_CSV=data/universe/fundamentals_overlay.csv
FORTUNA_MARKET_UNIVERSE_FUNDAMENTALS_OVERLAY_MAX_BOOST=0.05
FORTUNA_MARKET_UNIVERSE_FUNDAMENTALS_QUALITY_WEIGHT=1.0
FORTUNA_SCALING_BASKET_SMALL_MAX=8
FORTUNA_SCALING_BASKET_MEDIUM_MAX=15
FORTUNA_SCALING_ENFORCE_BASKET_CAP=false
FORTUNA_NIGHTLY_REPORT_RETENTION_ENABLED=false
FORTUNA_NIGHTLY_REPORT_RETENTION_COUNT=30
FORTUNA_OBSERVABILITY_ENABLED=false
FORTUNA_OBSERVABILITY_LOG_DIR=logs/observability
FORTUNA_OBSERVABILITY_EXPORTER=local
FORTUNA_OBSERVABILITY_OTLP_ENDPOINT=
FORTUNA_NIGHTLY_AUTOMATION_ENABLED=false
FORTUNA_NIGHTLY_FAIL_FAST_GLOBAL_BLOCKERS=true
FORTUNA_NIGHTLY_LANE_GATING_ENABLED=true
FORTUNA_TRAINING_CANDIDATE_NIGHTLY_FEEDBACK_ENABLED=true
FORTUNA_TRAINING_CANDIDATE_VOLUME_RATIO_BONUS_WEIGHT=0.08
FORTUNA_TRAINING_CANDIDATE_TRENDING_BONUS_WEIGHT=0.04
FORTUNA_TRAINING_CANDIDATE_SCOUT_OVERLAP_BOOST=0.04
FORTUNA_TRAINING_CANDIDATE_SCOUT_VOLUME_DENSE_BOOST=0.03
FORTUNA_TRAINING_CANDIDATE_NIGHTLY_FEEDBACK_MAX_BOOST=0.08
FORTUNA_TRAINING_CANDIDATE_NIGHTLY_FEEDBACK_LOOKBACK_REPORTS=8
FORTUNA_TRAINING_CANDIDATE_NIGHTLY_REFRESH_BONUS_WEIGHT=0.70
FORTUNA_TRAINING_CANDIDATE_NIGHTLY_REPORT_DIR=reports/nightly
FORTUNA_SHORTLIST_DISCOVERY_ALIGNMENT_ENABLED=true
FORTUNA_SHORTLIST_DISCOVERY_ALIGNMENT_BOOST=0.05
FORTUNA_SHORTLIST_DISCOVERY_ALIGNMENT_PENALTY=0.03
FORTUNA_PORTFOLIO_ALLOCATOR_CONTEXT_WEIGHTING_ENABLED=true
FORTUNA_PORTFOLIO_ALLOCATOR_REGIME_WEIGHT=0.06
FORTUNA_PORTFOLIO_ALLOCATOR_ACTIVITY_WEIGHT=0.04
FORTUNA_PORTFOLIO_ALLOCATOR_MAX_SINGLE_WEIGHT=0.60
FORTUNA_PORTFOLIO_ALLOCATOR_MAX_HIGH_RISK_POSITIONS=1
FORTUNA_PORTFOLIO_ALLOCATOR_MAX_PER_REGIME=2
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_ENABLED=true
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_SAME_SIDE_PENALTY=0.05
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_SAME_REGIME_PENALTY=0.04
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_WATCH_PENALTY=0.04
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_HIGH_RISK_PENALTY=0.06
FORTUNA_PORTFOLIO_ALLOCATOR_DISCOVERY_ALIGNMENT_ENABLED=true
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_WEAKER_DISCOVERY_PENALTY=0.025
FORTUNA_PORTFOLIO_ALLOCATOR_RESEARCH_ALIGNMENT_ENABLED=false
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_MISSING_RESEARCH_PENALTY=0.04
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_WEAKER_RESEARCH_PENALTY=0.03
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_UNREFRESHED_RESEARCH_PENALTY=0.02
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_WEAKER_NIGHTLY_RESEARCH_PENALTY=0.025
FORTUNA_PORTFOLIO_ALLOCATOR_CRITIC_BLOCK_THRESHOLD=0.14
FORTUNA_PORTFOLIO_ALLOCATOR_NIGHTLY_FEEDBACK_ENABLED=true
FORTUNA_PORTFOLIO_ALLOCATOR_NIGHTLY_FEEDBACK_LOOKBACK_REPORTS=8
FORTUNA_PORTFOLIO_ALLOCATOR_NIGHTLY_REFRESH_BONUS_WEIGHT=0.65
FORTUNA_PORTFOLIO_ALLOCATOR_NIGHTLY_PROMOTE_BONUS_WEIGHT=0.30
FORTUNA_PORTFOLIO_ALLOCATOR_NIGHTLY_REPORT_DIR=reports/nightly
FORTUNA_MODEL_STATUS_NIGHTLY_ALIGNMENT_ENABLED=true
FORTUNA_MODEL_STATUS_NIGHTLY_ALIGNMENT_LOOKBACK_REPORTS=8
FORTUNA_MODEL_STATUS_NIGHTLY_REPORT_DIR=reports/nightly
FORTUNA_MODEL_STATUS_NIGHTLY_ALIGNMENT_RECOMMENDATION_RATIO=0.75
FORTUNA_ACCEPTANCE_BUNDLE_NIGHTLY_ALIGNMENT_MIN_ENABLED_REPORTS=2
