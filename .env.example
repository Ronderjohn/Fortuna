SMARTAPI_API_KEY=your_api_key
SMARTAPI_CLIENT_CODE=your_client_id
SMARTAPI_PASSWORD=your_trading_pin
SMARTAPI_TOTP_SECRET=your_totp_secret_base32

# Optional alias for API key:
# ANGEL_API_KEY=same_as_above

# For live WebSocket feed:
SMARTAPI_USE_LIVE_FEED=true

# Set to true only on machines where TLS-intercepting antivirus (Avast/AVG etc.)
# or a corporate proxy replaces server certificates with locally signed ones
# that aren't in Python's certifi bundle. Disables SSL verification process-wide.
FORTUNA_INSECURE_SSL=false

# Agentic advisory layer (advisory-first; optional paper learning).
FORTUNA_AGENTIC_ENABLED=false
FORTUNA_AGENTIC_PAPER_LEARNING_ENABLED=false
FORTUNA_AGENTIC_ML_SCORER_ENABLED=false
FORTUNA_AGENTIC_LOG_DIR=logs/agentic

# Model promotion registry (Phase 5). Off by default — legacy mtime loading preserved.
# When enabled with promotion required, only explicit live pointers are loaded.
FORTUNA_MODEL_REGISTRY_ENABLED=false
FORTUNA_MODEL_PROMOTION_REQUIRED=true
FORTUNA_ML_SCORER_ARTIFACT_DIR=models/ml_signal_scorer/validated
# Dev-only escape hatch for RL; leave false in operator environments.
FORTUNA_RL_ALLOW_GLOBAL_POLICY=false

# Paper/execution stack (agentic paper learning uses paper broker only; never live orders).
FORTUNA_EXECUTION_ENABLED=false
FORTUNA_EXECUTION_ACCOUNT_SYNC=false

# Telegram alerts via bot token + chat id.
FORTUNA_TELEGRAM_ENABLED=false
FORTUNA_TELEGRAM_PROVIDER=telegram
FORTUNA_TELEGRAM_DEDUPE_MEMORY=500
FORTUNA_TELEGRAM_MAX_PER_SYMBOL_PER_SESSION=10
FORTUNA_TELEGRAM_MIN_INTERVAL_SECONDS=300
FORTUNA_TELEGRAM_QUIET_HOURS_ENABLED=true
FORTUNA_TELEGRAM_BOT_TOKEN=
FORTUNA_TELEGRAM_CHAT_ID=
FORTUNA_TELEGRAM_REQUEST_AUDIT_ENABLED=true
# Native conversational layer above typed advisory tools. Keep off by default
# until you explicitly want freer-form Telegram/dashboard prompts.
FORTUNA_CONVERSATIONAL_ADAPTER_ENABLED=false
FORTUNA_CONVERSATIONAL_ADAPTER_MODE=heuristic
FORTUNA_CONVERSATIONAL_MAX_HISTORY=12
